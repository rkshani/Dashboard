# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://pilotdesk.app
NEXT_PUBLIC_CONTACT_EMAIL=hello@pilotdesk.app

# Supabase project (Settings → API). The anon key is safe to expose:
# row-level security only lets it insert into the waitlist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
