# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Supabase project (Settings → API). The anon key is safe to expose:
# row-level security only lets it insert into the waitlist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Opportunity engine ----
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 16+ characters. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
# Optional: company career pages to follow (public job-board endpoints only)
# GREENHOUSE_BOARDS=boardtoken:Company Name,another:Another Co
# LEVER_SITES=sitename:Company Name
# Optional, demo mode only: pull the real public feeds into memory instead of example postings
# DEMO_LIVE_FEED=1
