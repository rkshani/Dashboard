# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Supabase project (Settings → API). The anon key is safe to expose:
# row-level security only lets it insert into the waitlist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Opportunity engine ----
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 16+ characters. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
# Optional: company career pages to follow (public job-board endpoints only)
# GREENHOUSE_BOARDS=boardtoken:Company Name,another:Another Co
# LEVER_SITES=sitename:Company Name
# Optional, demo mode only: pull the real public feeds into memory instead of example postings
# DEMO_LIVE_FEED=1

# ---- Google Calendar ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: https://your-domain.com/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32   (encrypts stored refresh tokens)
TOKEN_ENCRYPTION_KEY=

# ---- Daily digest email (Resend) ----
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Dashboard <digest@your-domain.com>"
DIGEST_FROM_EMAIL=
